{
  "name": "@inbrowser/model",
  "version": "0.5.0",
  "description": "Shared ModelClient contract, usage helpers, and withRetry for the inbrowser stack. Cloud providers are imported from @inbrowser/model/providers/<name>. Opt-in on-device inference lives at @inbrowser/model/local and lazy-loads the optional @huggingface/transformers peer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./providers/gemini": {
      "types": "./dist/providers/gemini.d.ts",
      "import": "./dist/providers/gemini.js"
    },
    "./providers/firebase-ai-logic": {
      "types": "./dist/providers/firebase-ai-logic.d.ts",
      "import": "./dist/providers/firebase-ai-logic.js"
    },
    "./providers/openrouter": {
      "types": "./dist/providers/openrouter.d.ts",
      "import": "./dist/providers/openrouter.js"
    },
    "./providers/openrouter-oauth": {
      "types": "./dist/providers/openrouter-oauth.d.ts",
      "import": "./dist/providers/openrouter-oauth.js"
    },
    "./providers/requesty": {
      "types": "./dist/providers/requesty.d.ts",
      "import": "./dist/providers/requesty.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js"
    },
    "./providers/oai-compat": {
      "types": "./dist/providers/oai-compat.d.ts",
      "import": "./dist/providers/oai-compat.js"
    },
    "./providers/ollama": {
      "types": "./dist/providers/ollama.d.ts",
      "import": "./dist/providers/ollama.js"
    },
    "./providers/llama-server": {
      "types": "./dist/providers/llama-server.d.ts",
      "import": "./dist/providers/llama-server.js"
    },
    "./providers/claude-cli": {
      "types": "./dist/providers/claude-cli.d.ts",
      "import": "./dist/providers/claude-cli.js"
    },
    "./providers/claude-code": {
      "types": "./dist/providers/claude-code.d.ts",
      "import": "./dist/providers/claude-code.js"
    }
  },
  "files": ["dist", "README.md", "AGENTS.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@huggingface/transformers": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideast/inbrowser-agent.git",
    "directory": "packages/model"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
