{
  "name": "@inbrowser/relay",
  "version": "0.3.0",
  "description": "Resumable LLM inference relay. Pre-wires @inbrowser/resumable with the shared @inbrowser/model contract: createRelay routes a providers map of ModelClientFactory (the cloud providers live in @inbrowser/model/providers/*), constructing a ModelClient per request so BYOK + server-managed keys both work. Web-standard handlers, Astro/Express adapters, and a reconnecting browser client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inbrowser/model": "workspace:^",
    "@inbrowser/resumable": "workspace:^"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "express": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideast/inbrowser-agent.git",
    "directory": "packages/relay"
  },
  "license": "MIT"
}
