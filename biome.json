{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": ["dist", "node_modules", "*.tsbuildinfo", "packages/node/vendor"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off",
        "noUselessSwitchCase": "off",
        "useOptionalChain": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noUnusedTemplateLiteral": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off"
      },
      "performance": {
        "noDelete": "off"
      }
    }
  },
  "overrides": [
    {
      "include": ["examples/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "noSwitchDeclarations": "off"
          },
          "a11y": {
            "useMediaCaption": "off"
          }
        }
      }
    },
    {
      "include": ["packages/node/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noThisInStatic": "off",
            "noUselessConstructor": "off"
          },
          "security": {
            "noGlobalEval": "off"
          },
          "style": {
            "noArguments": "off",
            "noParameterAssign": "off",
            "useNodejsImportProtocol": "off"
          },
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    },
    {
      "include": ["packages/node/tests/unit/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "off"
          },
          "suspicious": {
            "noApproximativeNumericConstant": "off",
            "noSparseArray": "off"
          }
        }
      }
    },
    {
      "include": ["packages/driver/src/preload/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          },
          "style": {
            "noCommaOperator": "off",
            "useNumberNamespace": "off"
          },
          "suspicious": {
            "useValidTypeof": "off"
          }
        }
      }
    }
  ]
}
