---
import { ChatApp } from '../components/chat/ChatApp';
import BaseLayout from '../layouts/BaseLayout.astro';

// The home is the chat. Its empty state is the landing (hero + suggestions +
// package cards); asking a question turns it into the conversation. One chat
// everywhere: `/chat` redirects here (see astro.config.ts).
---
<BaseLayout title="inbrowser — resumable, grounded AI in the browser">
  <ChatApp client:load />
</BaseLayout>
