# Copy to site/.env and fill in. site/.env is gitignored.

# Agent backend: 'gemini' (default, fast, needs a key) or 'ollama' (local).
DOCS_AGENT_PROVIDER=gemini

# Gemini API key (required when DOCS_AGENT_PROVIDER=gemini).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Defaults: gemini -> gemini-3.5-flash,
# ollama -> qwen3:4b.
# DOCS_AGENT_MODEL=gemini-3.5-flash

# Ollama base URL (only when DOCS_AGENT_PROVIDER=ollama).
# OLLAMA_BASE_URL=http://localhost:11434
